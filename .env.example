# X — environment template. Copy to .env and fill in. Never commit .env.
CONTABO_IP_ADDRESS=
CONTABO_INSTANCE_NAME=
CONTABO_PROVIDER=contabo
CONTABO_SSH_PORT=22
CONTABO_LOGIN_USERNAME=root
CONTABO_LOGIN_PASSWORD=
CONTABO_SSH_KEY_PATH=
ALERT_EMAIL=
REMOTE_SCRIPT_DIR=/tmp

# --- Gemini (script writing). Key values live in the ignored key file, never here. ---
# See skills/x-gemini-key-pool. Pools: config/gemini-pools.json (key ids only).
GEMINI_KEYS_FILE=Gemini api key
GEMINI_MODEL=gemini-3.8-flash

# --- YouTube OAuth: one client per workflow, each from that client's own Google console. ---
# Redirect URI registered in each console: http://localhost:8765/<workflow>/callback
JEPHTER_GOOGLE_CLIENT_ID=
JEPHTER_GOOGLE_CLIENT_SECRET=
EMMANUEL_GOOGLE_CLIENT_ID=
EMMANUEL_GOOGLE_CLIENT_SECRET=

# --- The site that serves each client's privacy/terms pages (Google needs a domain + TLS). ---
SITE_HOST=
