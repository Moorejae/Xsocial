# X — environment template. Copy to .env and fill in. Never commit .env.
CONTABO_IP_ADDRESS=
CONTABO_INSTANCE_NAME=
CONTABO_PROVIDER=contabo
CONTABO_SSH_PORT=22
CONTABO_LOGIN_USERNAME=root
CONTABO_LOGIN_PASSWORD=
CONTABO_SSH_KEY_PATH=
ALERT_EMAIL=
REMOTE_SCRIPT_DIR=/tmp

# --- Gemini (script writing). Key values live in the ignored key file, never here. ---
# See skills/x-gemini-key-pool. Pools: config/gemini-pools.json (key ids only).
GEMINI_KEYS_FILE=Gemini api key
GEMINI_MODEL=gemini-3.8-flash

# --- YouTube OAuth: one client per workflow, each from that client's own Google console. ---
# Redirect URI registered in each console: http://localhost:8765/<workflow>/callback
JEPHTER_GOOGLE_CLIENT_ID=
JEPHTER_GOOGLE_CLIENT_SECRET=
EMMANUEL_GOOGLE_CLIENT_ID=
EMMANUEL_GOOGLE_CLIENT_SECRET=

# --- Shared OAuth client. Since 2026-11-01 both X accounts sit in the audience of ForChi's client, so
# one client serves three channels and each channel only has to sign in. Leave these blank to read
# ForChi's YOUTUBE_CLIENT_ID/_SECRET in place. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Per-channel refresh tokens, normally written by scripts/youtube_auth.py, not by hand. ---
JEPHTER_REFRESH_TOKEN=
EMMANUEL_REFRESH_TOKEN=

# --- The site that serves each client's privacy/terms pages (Google needs a domain + TLS). ---
SITE_HOST=

# --- Encryption at rest for the YouTube refresh tokens. base64 of 32 random bytes. ---
# Generate once: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
X_SECRET_KEY=

# --- Optional: extra OAuth scopes, requested on the NEXT consent only. Leave empty for normal work. ---
# `youtube.upload` cannot call videos.update, so a title/description/privacy mistake after upload
# cannot be corrected by the token that caused it. Google accepts only youtubepartner, youtube or
# youtube.force-ssl for that call. Set the value below and re-authorise when a correction is needed;
# it broadens what the client approves, so it is opt-in rather than default.
X_EXTRA_SCOPES=
