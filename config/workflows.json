      "outline": 4,
      "shadow": 2,
      "margin_v": 420
    },
    "watermark": {
      "text": "Jephter",
      "font": "fonts/CormorantGaramond-SemiBold.ttf",
      "size": 34,
      "opacity": 0.55
    },
    "music": {
      "gain": 0.2,
      "fade_in": 1.4,
      "fade_out": 2.2
    },
    "schedule": {
      "timezone": "Africa/Lagos",
      "daily_count": 2,
      "produce_hours": [
        7,
        14
      ],
      "post_hours": [
        10,
        17
      ],
      "jitter_base_minutes": 0,
      "jitter_day_span_minutes": 15,
      "max_attempts_per_slot": 3,
      "retry_minutes": [
        10,
        25
      ],
      "transient_retry_minutes": 4,
      "max_transient_retries": 12
    }
  },
